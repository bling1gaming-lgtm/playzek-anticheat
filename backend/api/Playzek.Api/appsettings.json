{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Playzek": {
    "Database": { "Provider": "Postgres", "MigrateOnStartup": false },
    "Jwt": { "Issuer": "playzek-anticheat", "Audience": "playzek-anticheat-clients", "SigningKey": "" },
    "Sessions": {
      "SessionLifetime": "06:00:00",
      "HeartbeatInterval": "00:00:15",
      "HeartbeatGracePeriod": "00:00:45",
      "MinimumClientVersion": "0.1.0"
    },
    "Security": { "MaxFailedLogins": 5, "LockoutDuration": "00:15:00", "MaxActiveDevicesPerUser": 3 },
    "RateLimits": { "AuthPerMinute": 10, "ClientPerMinute": 120, "GameServerPerMinute": 1200 },
    "TrustedProxies": []
  }
}
