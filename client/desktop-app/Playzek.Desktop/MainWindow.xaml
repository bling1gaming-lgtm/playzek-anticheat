<Window x:Class="Playzek.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLAYZEK ANTI-CHEAT" Width="1000" Height="720" MinWidth="900" MinHeight="640"
        Background="{StaticResource Graphite}" Foreground="{StaticResource Silver}" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- Antet -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1" Padding="18,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource Orange}">
            <TextBlock Text="P" FontWeight="Black" FontSize="17" Foreground="#140800"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="PLAYZEK ANTI-CHEAT" FontWeight="Bold" FontSize="14"/>
            <TextBlock x:Name="VersionText" Style="{StaticResource Label}" Text="—"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Ellipse x:Name="BackendDot" Width="8" Height="8" Fill="{StaticResource Muted}" Margin="0,0,7,0"/>
          <TextBlock x:Name="BackendText" Text="Server: necunoscut" Style="{StaticResource Label}" FontSize="12"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Serviciul nu rulează -->
    <Border x:Name="ServiceBanner" DockPanel.Dock="Top" Background="#2A1212" BorderBrush="{StaticResource Red}"
            BorderThickness="0,0,0,1" Padding="18,10" Visibility="Collapsed">
      <TextBlock x:Name="ServiceBannerText" Foreground="#FFB4B4" TextWrapping="Wrap"/>
    </Border>

    <Grid Margin="18">
      <!-- ===== Login / cont nou ===== -->
      <Border x:Name="LoginPanel" Style="{StaticResource Card}" Width="380" VerticalAlignment="Center" Padding="24">
        <StackPanel>
          <TextBlock x:Name="LoginTitle" Text="Autentificare" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,16"
                     Text="Folosește contul PlayZek. Datele de autentificare sunt trimise doar serverului PlayZek, prin conexiune criptată."/>
          <TextBlock Style="{StaticResource Label}" Text="Nume de utilizator"/>
          <TextBox x:Name="UsernameBox"/>
          <TextBlock Style="{StaticResource Label}" Text="Parolă"/>
          <PasswordBox x:Name="PasswordBox"/>
          <StackPanel x:Name="SteamPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="SteamID (SteamID64 sau STEAM_0:X:Y)"/>
            <TextBox x:Name="SteamIdBox"/>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,-4,0,10"
                       Text="Serverele PlayZek te recunosc după SteamID. Parola trebuie să aibă minim 10 caractere."/>
          </StackPanel>
          <TextBlock x:Name="LoginError" Foreground="{StaticResource Red}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
          <Button x:Name="LoginButton" Style="{StaticResource Primary}" Content="Autentificare" Click="OnLoginClick" IsDefault="True"/>
          <Button x:Name="ToggleModeButton" Style="{StaticResource Button}" Content="Nu ai cont? Creează unul"
                  Margin="0,8,0,0" Click="OnToggleModeClick"/>
        </StackPanel>
      </Border>

      <!-- ===== Panou principal ===== -->
      <Grid x:Name="DashboardPanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Stare protecție -->
          <Border Style="{StaticResource Card}" Padding="18">
            <StackPanel>
              <TextBlock Text="STARE PROTECȚIE" Style="{StaticResource SectionTitle}"/>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ProtectionDot" Width="12" Height="12" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProtectionText" Text="Inactivă" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="ProtectionDetail" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"
                         Text="Activează protecția înainte să intri pe un server PlayZek."/>
              <TextBlock Style="{StaticResource Label}" Text="Joc"/>
              <UniformGrid x:Name="GameBox" Columns="2" Margin="0,4,0,12">
                <RadioButton x:Name="GameCs16" Style="{StaticResource Segment}" Content="CS 1.6" Tag="cs16" IsChecked="True" Margin="0,0,4,0"/>
                <RadioButton x:Name="GameCs2" Style="{StaticResource Segment}" Content="CS2" Tag="cs2" Margin="4,0,0,0"/>
              </UniformGrid>
              <Button x:Name="EnableButton" Style="{StaticResource Primary}" Content="Activează protecția" Click="OnEnableClick"/>
              <Button x:Name="DisableButton" Style="{StaticResource Danger}" Content="Oprește protecția" Margin="0,8,0,0"
                      Click="OnDisableClick" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <!-- Sesiune curentă -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="SESIUNE CURENTĂ" Style="{StaticResource SectionTitle}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Validare server" Margin="0,2"/>
                <TextBlock x:Name="SessionValidation" Grid.Column="1" Text="—" Margin="0,2"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Ultimul heartbeat" Margin="0,2"/>
                <TextBlock x:Name="LastHeartbeat" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,2"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Expiră la" Margin="0,2"/>
                <TextBlock x:Name="SessionExpires" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,2"/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="ID sesiune" Margin="0,2"/>
                <TextBlock x:Name="SessionId" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,2" FontSize="11" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Cont și dispozitiv -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="CONT PLAYZEK ȘI DISPOZITIV" Style="{StaticResource SectionTitle}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Jucător" Margin="0,2"/>
                <TextBlock x:Name="AccountName" Grid.Column="1" Text="—" Margin="0,2"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="SteamID" Margin="0,2"/>
                <TextBlock x:Name="AccountSteam" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,2"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Stare cont" Margin="0,2"/>
                <TextBlock x:Name="AccountStatus" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,2" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Dispozitiv" Margin="0,2"/>
                <TextBlock x:Name="DeviceText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,2" TextWrapping="Wrap"/>
              </Grid>
              <Button Style="{StaticResource Button}" Content="Deconectare" Margin="0,10,0,0" Click="OnLogoutClick"/>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="200"/></Grid.RowDefinitions>

          <!-- Verificări de sistem -->
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                  <Button Style="{StaticResource Button}" Content="Exportă raport" Padding="10,5" Click="OnExportClick"/>
                  <Button x:Name="RunChecksButton" Style="{StaticResource Button}" Content="Verifică din nou" Padding="10,5"
                          Margin="8,0,0,0" Click="OnRunChecksClick"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="VERIFICĂRI DE SISTEM ȘI COMPATIBILITATE" Style="{StaticResource SectionTitle}" Margin="0"/>
                  <TextBlock x:Name="ChecksMeta" Style="{StaticResource Label}" Text="—"/>
                </StackPanel>
              </DockPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ChecksList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,9">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" Background="{Binding BadgeBrush}" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="#0B0C0E"/>
                        </Border>
                        <StackPanel Margin="0,0,10,0">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Summary}" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <!-- Evenimente -->
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="EVENIMENTE DE SECURITATE" Style="{StaticResource SectionTitle}"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EventsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,5">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource Label}" Width="62"/>
                        <TextBlock Text="{Binding Message}" Foreground="{Binding Brush}" FontSize="12" TextWrapping="Wrap"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
